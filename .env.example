# Required — Supabase client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — Sentry error reporting (production only)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional — build metadata, surfaced to Sentry releases
VITE_APP_VERSION=0.1.0

# Optional — set to 'true' to enable auth debug logs
VITE_DEBUG_AUTH=

# NEVER add VITE_SUPABASE_SERVICE_ROLE_KEY here.
# Anything prefixed VITE_ is bundled into client JS and shipped to browsers.
# The service role key bypasses RLS — keep it server-side only (Edge Functions,
# CI scripts) and use a non-VITE_ name there.
