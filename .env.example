# Claro4 environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env`, `.env.local`, and `.env.*` are gitignored — only `.env.example`
# (this file) is committed. Vite exposes any var prefixed with `VITE_` to
# client-side code via `import.meta.env.VITE_*`.

# ─── Supabase (required) ─────────────────────────────────────────────
# Project URL and anon (public) key from your Supabase dashboard.
# Without these, the app refuses to start in production builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key — admin server-side ops only. Do NOT expose this to
# the client. Currently only declared in src/types/env.d.ts; reserve
# for future server-side scripts. Most contributors should leave blank.
VITE_SUPABASE_SERVICE_ROLE_KEY=

# ─── App identity ────────────────────────────────────────────────────
VITE_APP_NAME=Claro
# Used as the Sentry release tag if Sentry is configured. Update on
# each deploy (e.g., the git SHA or a semver string).
VITE_APP_VERSION=0.0.0-dev
# Set to "development", "staging", or "production". Used as the Sentry
# `environment` tag. Vite already exposes import.meta.env.MODE; this is
# a separate explicit value when the deployment context differs.
VITE_ENVIRONMENT=development

# ─── Sentry (optional — graceful degradation if unset) ───────────────
# When set, errors from useErrorHandler.handleError(..., { reportToService: true })
# flow to your Sentry project. When unset, Sentry.init never runs and
# Sentry.captureException becomes a no-op. See main.ts for the gate.
#
# Setup:
#   1. Create a project at https://sentry.io (Vue platform)
#   2. Copy the DSN from Project Settings → Client Keys (DSN)
#   3. Paste below in .env.local (NOT this file — never commit a real DSN)
VITE_SENTRY_DSN=

# Fraction of transactions to trace (0.0–1.0). Default 0.1 = 10%.
# Lower for high-traffic prod; higher for staging/debug.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Debug flags (development convenience) ───────────────────────────
# When "true", logs Supabase auth state changes to the console.
# Useful when debugging login/logout flows. Default: unset/false.
VITE_DEBUG_AUTH=

# Reserved for RLS query debugging. Currently declared in .env.local
# but no consumer is wired up yet — safe to leave blank.
VITE_DEBUG_RLS=

# ─── Figma Code Connect ───────────────────────────────────────────────
# Personal access token from Figma → Account Settings → Personal access tokens
# Required scopes: File content (read) + Code Connect (write)
# Used only locally by `pnpm figma:publish` — never sent to the client.
FIGMA_ACCESS_TOKEN=
